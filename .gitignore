# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Secrets and local settings
.env
*.token
*.key
*.pem

# Model weights and caches (large, and downloaded on each machine)
# Anchored with a leading slash so they match only at the repository root,
# not source packages such as src/rca/data/
/models/
/weights/
*.safetensors
*.bin
*.gguf
*.pt
*.pth
.cache/

# Data: cloned repositories, benchmarks and derived indexes
/data/
/repos/
/indexes/

# Raw run output. Only small summary tables in results/ are committed
logs/
runs/
*.jsonl
results/raw/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
